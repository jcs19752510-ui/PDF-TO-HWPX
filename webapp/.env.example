# 로컬 개발용 예시 파일. 실제 .env는 절대 커밋하지 않는다(.gitignore 처리됨).
# Render 등 실제 배포 환경은 이 파일을 쓰지 않고 플랫폼 Environment
# Variables/Secrets에 직접 값을 등록한다.

DJANGO_SETTINGS_MODULE=config.settings.dev

# dev.py는 이 값이 없으면 개발 전용 기본 SECRET_KEY로 대체된다. production.py는
# 이 값이 없으면 기동 자체가 실패한다(의도된 동작).
SECRET_KEY=

# 비워두면 SQLite(webapp/db.sqlite3)로 폴백(dev.py). 로컬 Postgres나
# Neon으로 테스트하려면 postgres://user:password@host:5432/dbname 형태로
# 지정한다. Neon 사용 시: 실제 프로젝트가 아직 발급되지 않음(10~12단계에서
# 생성 예정).
DATABASE_URL=

# production.py 전용(dev에서는 사용하지 않음)
DJANGO_ALLOWED_HOSTS=

# Cloudflare R2(S3 호환) — production 전용. dev는 비워두면 로컬 디스크
# (webapp/.dev-media/)로 자동 폴백하므로 채우지 않아도 된다(03 §1-3 unit-19).
# 실제 버킷/키는 아직 발급되지 않음(10~12단계에서 생성 예정, DEC-027).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_REGION=auto

# R2 버킷 오브젝트 라이프사이클 규칙(백스톱, 03 §6-2/§3-2, REQ-028, DEC-029) — 환경변수가
# 아니라 R2 콘솔(또는 Terraform/wrangler 등 IaC)에서 버킷 생성 시(10~12단계) 직접 설정해야
# 하는 항목이라 여기서는 값이 아니라 "해야 할 설정"을 안내만 한다:
#   1. Cloudflare 대시보드 > R2 > (버킷 선택) > Settings > Object lifecycle rules > Add rule
#   2. 규칙 이름: 예) "ttl-backstop", 적용 대상: 버킷 전체(prefix 미지정, uploads/+results/ 둘 다 대상)
#   3. 액션: "Delete objects" (또는 "Expire objects"), 조건: "Age of object" = 1 day(24시간)
#   4. 이 규칙은 앱 로직(cleanup.py 지연 스윕, 60분 목표)이 실패하거나 트래픽 부재로 지연될
#      경우를 대비한 2차 방어선이다 — 정상 동작 시에는 오브젝트가 24시간보다 훨씬 먼저
#      (다운로드 즉시 또는 60분 이내) 삭제되므로 이 규칙이 실제로 발동하는 것은 예외 상황뿐이다.

# 장애 알림(03 §7-2) — 500 에러 발생 시 이 주소로 즉시 메일 발송.
# 쉼표로 여러 주소 구분 가능. 비워두면 알림이 조용히 발송되지 않을 뿐 기동은
# 막지 않는다(production.py).
DJANGO_ADMIN_EMAIL=

# 장애 알림 메일 발송에 쓰는 SMTP 설정(DJANGO_ADMIN_EMAIL과 짝을 이룬다).
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
SERVER_EMAIL=
